  <property name="styleSheet">
   <string notr="true">QWidget#UserDashboard { background:#F4F7FB; }
QFrame.card { background:#FFFFFF; border:1px solid #DCE3EC; border-radius:12px; }
QLabel.sectionTitle { color:#607D8B; font-size:12px; font-weight:bold; }
QLabel.value { color:#263238; font-size:18px; font-weight:bold; }
QLabel.smallValue { color:#455A64; font-size:14px; }
QLabel.blueValue { color:#1565C0; font-size:22px; font-weight:bold; }
QLabel.greenValue { color:#2E7D32; font-size:22px; font-weight:bold; }
QLabel.orangeValue { color:#EF6C00; font-size:22px; font-weight:bold; }
QLabel.muted { color:#78909C; font-size:13px; }
QLabel.statusDot { color:#2E7D32; font-size:18px; }
QLabel.resultOk { color:#2E7D32; font-size:18px; font-weight:bold; }
QLabel.resultFail { color:#C62828; font-size:18px; font-weight:bold; }</string>
